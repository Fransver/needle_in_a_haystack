# Copy to .env (which is gitignored) and fill in your local values.
# Used by the test/dummy app to connect to MySQL.

# MySQL user and password.
DB_USER=
DB_PASSWORD=

# Optional: override host, socket, or the database name prefix.
# DB_HOST=127.0.0.1
# DB_SOCKET=/tmp/mysql.sock
# NIAH_DATABASE=needle_in_a_haystack
