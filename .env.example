# Copy to .env (which is gitignored) and fill in your local values.
# Used by the test/dummy app to connect to MySQL.
#
# NIAH_-prefixed names avoid colliding with generic DB_* variables that may
# already be exported in your shell for another project.

NIAH_DB_USER=user
NIAH_DB_PASSWORD=

# Optional: override host, socket, or the database name prefix.
# NIAH_DB_HOST=127.0.0.1
# NIAH_DB_SOCKET=/tmp/mysql.sock
# NIAH_DATABASE=needle_in_a_haystack
